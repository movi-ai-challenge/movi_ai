# ============================================================
# MOVI AI 환경변수 예시
#
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
#   copy .env.example .env      (cmd)
#   cp   .env.example .env      (git bash)
#
# 애플리케이션 코드는 os.getenv 만 사용하므로,
# 서버는 uvicorn --env-file .env 로 실행해야 값이 주입된다.
# (pytest 는 루트 conftest.py 가 자동으로 .env 를 로드한다)
# ============================================================


# ------------------------------------------------------------
# Spring Backend 연동
# ------------------------------------------------------------
BACKEND_BASE_URL=https://moviback.duckdns.org
VOICE_COMMAND_ENDPOINT=/api/v1/voice/command
BACKEND_TIMEOUT=5


# ------------------------------------------------------------
# FDS (이상거래 탐지)
#
# FDS_MODEL_PATH 는 프로젝트 루트 기준 상대경로.
# 반드시 프로젝트 루트에서 서버를 실행해야 한다.
# ------------------------------------------------------------
FDS_MODEL_PATH=models/electronic/isolation_forest.joblib
FDS_THRESHOLD=0.44611697


# ------------------------------------------------------------
# OpenAI (requirement_analyzer)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano


# ------------------------------------------------------------
# Google Cloud STT / TTS
#
# 아래 두 값은 현재 .env 에 빠져 있다.
# stt_stream_service.py / tts_service.py 를 쓰려면 반드시 필요하다.
#
# GOOGLE_CLOUD_PROJECT 가 없으면 config.RECOGNIZER_PATH 가 None 이 되어
# STT 스트리밍이 동작하지 않는다.
# ------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Chirp 3 는 us / eu multi-region 에서만 제공
GOOGLE_STT_LOCATION=us
GOOGLE_STT_MODEL=chirp_3


# ------------------------------------------------------------
# 디버그 로그
# ------------------------------------------------------------
VOICE_DEBUG=true
